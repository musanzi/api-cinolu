#PORT
PORT=8000

## Database
# DB_HOST must be the compose service name ("db") when running via docker compose,
# or 127.0.0.1 when connecting to a locally/externally running MariaDB instance.
DB_HOST=db
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# MAIL
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Sessions
SESSION_SECRET=
SESSION_RESAVE=
SESSION_SAVE_UNINITIALIZED=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/redirect
FRONTEND_URI=http://localhost:4200